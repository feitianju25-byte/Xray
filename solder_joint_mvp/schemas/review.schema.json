{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "title": "Regular solder-array review",
  "type": "object",
  "required": ["schema_version", "algorithm_version", "created_at", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "instructions": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sample_id", "source_path", "decision", "array_bbox", "rows", "cols", "corners", "centers", "algorithm_version"],
        "properties": {
          "sample_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
          "source_path": {"type": "string"},
          "decision": {"enum": ["keep", "reject", "uncertain"]},
          "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
          "array_bbox": {"anyOf": [{"$ref": "#/$defs/bbox"}, {"type": "null"}]},
          "rows": {"type": ["integer", "null"], "minimum": 2},
          "cols": {"type": ["integer", "null"], "minimum": 3},
          "corners": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/point"}},
          "centers": {"type": "array", "items": {"$ref": "#/$defs/point"}},
          "notes": {"type": "string"},
          "algorithm_version": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
    "bbox": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false}
  }
}

