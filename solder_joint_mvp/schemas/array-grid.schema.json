{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "array-grid.schema.json",
  "title": "Fitted solder array grid",
  "type": "object",
  "required": ["schema_version", "sample_id", "array_id", "bbox", "rows", "cols", "basis_vectors", "spacing", "orientation_degrees", "confidence", "points"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sample_id": {"type": "string"},
    "array_id": {"type": "string"},
    "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "rows": {"type": "integer", "minimum": 2},
    "cols": {"type": "integer", "minimum": 3},
    "basis_vectors": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
    "spacing": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
    "orientation_degrees": {"type": "number"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["row", "col", "center", "scale", "confidence", "status"],
        "properties": {
          "row": {"type": "integer", "minimum": 0},
          "col": {"type": "integer", "minimum": 0},
          "center": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "scale": {"type": "number", "exclusiveMinimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {"enum": ["observed", "missing", "low_confidence"]}
        }
      }
    }
  }
}

