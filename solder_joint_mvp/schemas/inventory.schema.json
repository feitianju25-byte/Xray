{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.schema.json",
  "title": "Solder image inventory",
  "type": "object",
  "required": ["schema_version", "algorithm_version", "created_at", "roots", "summary", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "roots": {"type": "array", "items": {"type": "object", "required": ["alias", "path"]}},
    "summary": {
      "type": "object",
      "required": ["total", "ok", "error", "sources"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "ok": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "sources": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["sample_id", "root_alias", "relative_path", "source_dir", "absolute_path", "file_size", "status", "width", "height", "mode", "error"],
      "properties": {
        "sample_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "root_alias": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string"},
        "source_dir": {"type": "string"},
        "absolute_path": {"type": "string", "minLength": 1},
        "file_size": {"type": "integer", "minimum": 0},
        "status": {"enum": ["ok", "error"]},
        "width": {"type": ["integer", "null"], "minimum": 1},
        "height": {"type": ["integer", "null"], "minimum": 1},
        "mode": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]}
      }
    }
  }
}

