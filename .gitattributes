# Large binary artifacts are versioned through Git LFS so the repository
# remains cloneable and GitHub's 100 MB per-file limit is respected.
*.pt filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text

# Normalize text files across Windows and Linux training environments.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
